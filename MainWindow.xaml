<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="ScreenTimeTracker.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:ScreenTimeTracker"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:ScreenTimeTracker.Models"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.WinUI"
    mc:Ignorable="d"
    Closed="Window_Closed">

    <Window.SystemBackdrop>
        <MicaBackdrop Kind="Base"/>
    </Window.SystemBackdrop>

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="44"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Native draggable title bar. Keep it intentionally quiet so the activity
             view, not app chrome, owns the visual hierarchy. -->
        <Grid x:Name="AppTitleBar"
              Grid.Row="0"
              Height="44"
              Padding="16,0,148,0"
              Background="Transparent">
            <StackPanel Orientation="Horizontal"
                        Spacing="9"
                        VerticalAlignment="Center">
                <Image Width="22" Height="22">
                    <Image.Source>
                        <SvgImageSource UriSource="/Assets/screeny.svg"/>
                    </Image.Source>
                </Image>
                <TextBlock Text="Screeny"
                           FontSize="13"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- Page heading + compact controls -->
        <Grid Grid.Row="1"
              MaxWidth="980"
              Padding="32,18,32,0"
              HorizontalAlignment="Stretch">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Text="App activity"
                       FontSize="34"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"/>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="8"
                        VerticalAlignment="Center">
                <Button x:Name="DatePickerButton"
                        MinHeight="36"
                        Padding="14,6"
                        CornerRadius="18"
                        Content="{Binding FormattedSelectedDate}"
                        Command="{Binding PickDateCommand}"/>

                <Button x:Name="TrackingStatusButton"
                        MinHeight="36"
                        Padding="12,6"
                        CornerRadius="18"
                        Command="{Binding ToggleTrackingCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7">
                        <Ellipse Width="7"
                                 Height="7"
                                 Fill="{ThemeResource SystemAccentColor}"/>
                        <TextBlock x:Name="TrackingStatusText"
                                   Text="{Binding TrackingStatusText}"
                                   FontSize="13"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Digital-Wellbeing-style hero total -->
        <StackPanel Grid.Row="2"
                    MaxWidth="980"
                    Margin="32,26,32,6"
                    HorizontalAlignment="Stretch">
            <Border Padding="15,7"
                    CornerRadius="18"
                    Background="{ThemeResource AccentFillColorSecondaryBrush}"
                    HorizontalAlignment="Center">
                <TextBlock Text="Screen time"
                           FontSize="14"
                           FontWeight="SemiBold"/>
            </Border>

            <TextBlock x:Name="ChartTimeValue"
                       Text="0s"
                       Margin="0,20,0,0"
                       FontSize="58"
                       FontWeight="Light"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>

            <TextBlock Text="{Binding FormattedSelectedDate}"
                       Margin="0,3,0,0"
                       FontSize="15"
                       Opacity="0.68"
                       TextAlignment="Center"
                       HorizontalAlignment="Center"/>
        </StackPanel>

        <!-- Chart. No enclosing card and no decorative animation: fewer visual layers,
             closer to the reference, and cheaper to redraw. -->
        <Grid Grid.Row="3"
              MaxWidth="980"
              Margin="32,6,32,18"
              HorizontalAlignment="Stretch">
            <lvc:CartesianChart x:Name="UsageChartLive"
                                Height="210"
                                MinHeight="180"
                                Background="Transparent"/>

            <ProgressRing x:Name="LoadingIndicator"
                          Width="30"
                          Height="30"
                          IsActive="True"
                          Visibility="Collapsed"
                          HorizontalAlignment="Center"
                          VerticalAlignment="Center"/>
        </Grid>

        <!-- The app list owns the remaining height so ListView virtualization stays active.
             Avoid wrapping it in another ScrollViewer. -->
        <Grid Grid.Row="4"
              MaxWidth="980"
              Padding="32,0,32,24"
              HorizontalAlignment="Stretch">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="DateDisplay"
                           Text="Today"
                           FontSize="22"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1"
                           Text="Apps"
                           FontSize="13"
                           Opacity="0.60"
                           VerticalAlignment="Center"/>
            </Grid>

            <ListView x:Name="UsageListView"
                      Grid.Row="1"
                      ItemsSource="{Binding Records}"
                      SelectionMode="None"
                      IsItemClickEnabled="False"
                      HorizontalContentAlignment="Stretch">
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                        <Setter Property="MinHeight" Value="0"/>
                    </Style>
                </ListView.ItemContainerStyle>

                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:AppUsageRecord">
                        <Grid MinHeight="66" Padding="8,7">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Width="36"
                                    Height="36"
                                    CornerRadius="9"
                                    Background="{ThemeResource ControlFillColorSecondaryBrush}"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center">
                                <Grid>
                                    <FontIcon Glyph="&#xECAA;"
                                              FontSize="15"
                                              Opacity="0.45"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                    <Image Width="30"
                                           Height="30"
                                           Source="{x:Bind AppIcon, Mode=OneWay}"
                                           Stretch="Uniform"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <StackPanel Grid.Column="1"
                                        Margin="10,0,18,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{x:Bind ApplicationName, Mode=OneWay}"
                                           FontSize="17"
                                           FontWeight="SemiBold"
                                           TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{x:Bind ProcessName, Mode=OneWay}"
                                           Margin="0,2,0,0"
                                           FontSize="12"
                                           Opacity="0.52"
                                           TextTrimming="CharacterEllipsis"/>
                            </StackPanel>

                            <TextBlock Grid.Column="2"
                                       Text="{x:Bind FormattedDuration, Mode=OneWay}"
                                       FontSize="14"
                                       Opacity="0.78"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"/>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <!-- Compatibility elements retained for existing code-behind while the old
             summary/control surface is removed from the visible UI. -->
        <Grid Visibility="Collapsed">
            <TextBlock x:Name="ChartTitleLabel" Text="Screen time"/>
            <TextBlock x:Name="SummaryTitle" Text="Daily Screen Time Summary"/>
            <TextBlock x:Name="TotalScreenTime" Text="0s"/>

            <StackPanel x:Name="ViewModePanel" Visibility="Collapsed">
                <TextBlock x:Name="ViewModeLabel" Text="Hourly View"/>
                <Button Command="{Binding ToggleViewModeCommand}"/>
            </StackPanel>

            <Button x:Name="StartButton"
                    Content="Start"
                    Command="{Binding StartTrackingCommand}"
                    Visibility="Collapsed"/>
            <Button x:Name="StopButton"
                    Content="Stop"
                    Command="{Binding StopTrackingCommand}"
                    Visibility="Collapsed"/>

            <StackPanel>
                <Image x:Name="MostUsedAppIcon" Width="1" Height="1"/>
                <FontIcon x:Name="MostUsedPlaceholderIcon" Glyph="&#xECAA;"/>
                <TextBlock x:Name="MostUsedApp"/>
                <TextBlock x:Name="MostUsedAppTime"/>
            </StackPanel>

            <StackPanel x:Name="IdleRow" Visibility="Collapsed">
                <TextBlock x:Name="IdleTimeValue"/>
            </StackPanel>

            <StackPanel x:Name="AveragePanel" Visibility="Collapsed">
                <TextBlock x:Name="DailyAverage"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
